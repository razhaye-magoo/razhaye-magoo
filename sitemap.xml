---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ '/' | absolute_url }}</loc><changefreq>daily</changefreq><priority>1.0</priority></url>
  {% for p in site.posts %}{% unless p.noindex %}
  <url><loc>{{ p.url | absolute_url }}</loc><lastmod>{{ p.date | date_to_xmlschema }}</lastmod></url>
  {% endunless %}{% endfor %}
  {% for pg in site.pages %}{% if pg.title and pg.url != '/404.html' and pg.url != '/search/' %}
  <url><loc>{{ pg.url | absolute_url }}</loc></url>
  {% endif %}{% endfor %}
</urlset>
