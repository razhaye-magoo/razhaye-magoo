---
layout: null
permalink: /feed.xml
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="fa">
  <title>{{ site.title | xml_escape }}</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml"/>
  <link href="{{ '/' | absolute_url }}" rel="alternate" type="text/html"/>
  <id>{{ '/' | absolute_url }}</id>
  <updated>{% if site.posts.first %}{{ site.posts.first.modified | default: site.posts.first.date | date_to_xmlschema }}{% else %}{{ site.time | date_to_xmlschema }}{% endif %}</updated>
  {% if site.author %}<author><name>{{ site.author | xml_escape }}</name></author>{% endif %}
  {% for p in site.posts limit: 30 %}{% unless p.noindex %}
  <entry>
    <title>{{ p.title | xml_escape }}</title>
    <link href="{{ p.url | absolute_url }}" rel="alternate" type="text/html"/>
    <id>{{ p.url | absolute_url }}</id>
    <published>{{ p.date | date_to_xmlschema }}</published>
    <updated>{{ p.modified | default: p.date | date_to_xmlschema }}</updated>
    {% if p.description %}<summary>{{ p.description | xml_escape }}</summary>{% endif %}
    {% assign fc = p.image | default: p.cover %}{% if fc %}<link rel="enclosure" href="{% if fc contains '://' %}{{ fc }}{% else %}{{ fc | absolute_url }}{% endif %}"/>{% endif %}
    {% for t in p.tags %}<category term="{{ t | xml_escape }}"/>{% endfor %}
    <content type="html">{{ p.content | strip_newlines | xml_escape }}</content>
  </entry>
  {% endunless %}{% endfor %}
</feed>
